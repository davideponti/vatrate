# 🚧 COPIA QUESTO FILE IN .env.local E SOSTITUISCI I VALORI
# ⚠️ NON COMMITTARE MAI .env.local NEL REPO!

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Per ottenere il webhook secret: vai su Dashboard Stripe → Developers → Webhooks
# → Aggiungi endpoint: https://vatrate.eu/webhook/stripe (o http://localhost:3000/api/webhook/stripe per sviluppo)
# → Copia il "Signing secret" (whsec_...) qui
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Resend (email)
RESEND_API_KEY=re_...

# Upstash Redis (rate limiting)
# Opzionale: se non impostato, usa rate limiting in-memory (non serverless-safe)
UPSTASH_REDIS_REST_URL=https://your-region.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# OAuth - GitHub
# 1. Vai su https://github.com/settings/developers → New OAuth App
# 2. Homepage URL: https://vatrate.eu (o http://localhost:3000 per sviluppo)
# 3. Authorization callback URL: https://vatrate.eu/api/v1/auth/oauth/callback/github
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# OAuth - Google
# 1. Vai su https://console.cloud.google.com/apis/credentials → Create OAuth client ID
# 2. Application type: Web application
# 3. Authorized redirect URIs: https://vatrate.eu/api/v1/auth/oauth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# App URL (per reindirizzamenti OAuth)
# Imposta al tuo dominio in produzione, http://localhost:3000 in sviluppo
NEXT_PUBLIC_APP_URL=http://localhost:3000
