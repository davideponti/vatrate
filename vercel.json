{
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "buildCommand": "npx turbo run build --filter=@vatrate/web...",
  "outputDirectory": "apps/web/.next",
  "framework": "nextjs",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ],
  "redirects": [
    {
      "source": "www.vatrate.eu",
      "destination": "https://vatrate.eu",
      "permanent": true
    }
  ]
}
